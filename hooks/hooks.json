{
  "description": "Opt-in: lower the music while Claude waits for you (CMUSIC_DUCK=1)",
  "hooks": {
    "Notification": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/cmusic\" hook notify" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/cmusic\" hook prompt" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/cmusic\" hook tool" }] }
    ]
  }
}
